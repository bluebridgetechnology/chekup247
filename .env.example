# ==============================================================================
# ChekUp247 Environment Configuration
# ==============================================================================

# Node Environment
NODE_ENV=development
PORT=4000

# ------------------------------------------------------------------------------
# 1. Operational Database (VPS / Local PostgreSQL - Port 5434)
# ------------------------------------------------------------------------------
OPERATIONAL_DB_HOST=localhost
OPERATIONAL_DB_PORT=5434
OPERATIONAL_DB_USER=chekup_user
OPERATIONAL_DB_PASSWORD=chekup_password
OPERATIONAL_DB_NAME=chekup_operational
OPERATIONAL_DB_SSL=false
DATABASE_OPERATIONAL_URL=postgresql://chekup_user:chekup_password@localhost:5434/chekup_operational

# ------------------------------------------------------------------------------
# 2. Patient & Health Database (Local / VPS / AWS RDS af-south-1 - Port 5433)
# ------------------------------------------------------------------------------
PATIENT_DB_HOST=localhost
PATIENT_DB_PORT=5433
PATIENT_DB_USER=chekup_user
PATIENT_DB_PASSWORD=chekup_password
PATIENT_DB_NAME=chekup_patient
PATIENT_DB_SSL=false
DATABASE_PATIENT_URL=postgresql://chekup_user:chekup_password@localhost:5433/chekup_patient

# ------------------------------------------------------------------------------
# 3. Redis & BullMQ
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_password

# ------------------------------------------------------------------------------
# 4. Storage (MinIO / Cloudflare R2 / AWS S3)
# ------------------------------------------------------------------------------
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=af-south-1
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadminpassword
STORAGE_BUCKET_DOCUMENTS=chekup-documents
STORAGE_BUCKET_PRESCRIPTIONS=chekup-prescriptions
STORAGE_FORCE_PATH_STYLE=true

# ------------------------------------------------------------------------------
# 5. Security & JWT
# ------------------------------------------------------------------------------
JWT_SECRET=super-secret-development-jwt-key-minimum-32-chars
JWT_EXPIRES_IN=7d
ADMIN_SESSION_SECRET=admin-isolated-session-secret-key-32-chars

# ------------------------------------------------------------------------------
# 6. Platform Settings & URLs
# ------------------------------------------------------------------------------
API_BASE_URL=http://localhost:4000
PATIENT_WEB_URL=http://localhost:3000
DOCTOR_PORTAL_URL=http://localhost:3001
ADMIN_PANEL_URL=http://localhost:3002
