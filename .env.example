# ==============================================================================
# ChekUp247 Environment Configuration
# ==============================================================================

# Node Environment
NODE_ENV=development
PORT=4000

# ------------------------------------------------------------------------------
# 1. Operational Database (VPS / Local PostgreSQL - Port 5434)
# ------------------------------------------------------------------------------
OPERATIONAL_DB_HOST=localhost
OPERATIONAL_DB_PORT=5434
OPERATIONAL_DB_USER=chekup_user
OPERATIONAL_DB_PASSWORD=chekup_password
OPERATIONAL_DB_NAME=chekup_operational
OPERATIONAL_DB_SSL=false
DATABASE_OPERATIONAL_URL=postgresql://chekup_user:chekup_password@localhost:5434/chekup_operational

# ------------------------------------------------------------------------------
# 2. Patient & Health Database (Local / VPS / AWS RDS af-south-1 - Port 5433)
# ------------------------------------------------------------------------------
PATIENT_DB_HOST=localhost
PATIENT_DB_PORT=5433
PATIENT_DB_USER=chekup_user
PATIENT_DB_PASSWORD=chekup_password
PATIENT_DB_NAME=chekup_patient
PATIENT_DB_SSL=false
DATABASE_PATIENT_URL=postgresql://chekup_user:chekup_password@localhost:5433/chekup_patient

# ------------------------------------------------------------------------------
# 3. Redis & BullMQ
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_password

# ------------------------------------------------------------------------------
# 4. Storage (MinIO / Cloudflare R2 / AWS S3)
# ------------------------------------------------------------------------------
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=af-south-1
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadminpassword
STORAGE_BUCKET_DOCUMENTS=chekup-documents
STORAGE_BUCKET_PRESCRIPTIONS=chekup-prescriptions
STORAGE_FORCE_PATH_STYLE=true

# ------------------------------------------------------------------------------
# 5. Security & JWT
# ------------------------------------------------------------------------------
JWT_SECRET=super-secret-development-jwt-key-minimum-32-chars
JWT_EXPIRES_IN=7d
ADMIN_SESSION_SECRET=admin-isolated-session-secret-key-32-chars

# ------------------------------------------------------------------------------
# 6. Platform Settings & URLs
# ------------------------------------------------------------------------------
API_BASE_URL=http://localhost:4000
PATIENT_WEB_URL=http://localhost:3000
DOCTOR_PORTAL_URL=http://localhost:3001
ADMIN_PANEL_URL=http://localhost:3002

# ------------------------------------------------------------------------------
# 7. SMS Portal Gateway (South Africa - https://cp.smsportal.com)
# ------------------------------------------------------------------------------
SMSPORTAL_API_KEY=
SMSPORTAL_API_SECRET=
SMSPORTAL_API_URL=https://rest.smsportal.com

# ------------------------------------------------------------------------------
# 8. Daily.co Video Consultations (WebRTC Telehealth)
# ------------------------------------------------------------------------------
# ONLY your Daily API key is required. Daily's REST API automatically generates
# dynamic, isolated room URLs for each consultation (no domain or room name needed).
# Get your API key from https://dashboard.daily.co/developers
DAILY_API_KEY=

# ------------------------------------------------------------------------------
# 9. LocumStaff Integration — Partner Directory + OIDC SSO
# ------------------------------------------------------------------------------
# LocumStaff is the identity & staffing source of truth (read-only handover).
# Register ChekUp247 on the LocumStaff side (Admin -> System -> Integrations)
# and paste the four values it generates below. They MUST match exactly.
#
# Base API URL. Must be a REAL, reachable LocumStaff host — a value containing
# ".example" is treated as unconfigured and the integration fails closed
# (no doctors are synced, SSO is refused) rather than fabricating fake data.
LOCUMSTAFF_API_URL=https://api.locumstaff.example
#
# Server-to-server key for the doctor directory + availability feed
# (sent as the X-API-Key header on GET /v1/partner-directory/*).
LOCUMSTAFF_DIRECTORY_API_KEY=
#
# OIDC credentials for the SSO handshake (authorization code + PKCE).
# The client secret is server-side only — never expose it client-side.
LOCUMSTAFF_OIDC_CLIENT_ID=
LOCUMSTAFF_OIDC_CLIENT_SECRET=
# Must EXACTLY match the redirect URI you register with LocumStaff and send
# in /authorize and /token. Leave blank to default to <DOCTOR_PORTAL_URL>/callback.
# Production example: https://doctor.chekup.co.za/callback
LOCUMSTAFF_OIDC_REDIRECT_URI=
#
# NOTE — willing_virtual eligibility gate:
# ChekUp247 only grants SSO to a doctor whose LocumStaff id_token carries
# willing_virtual=true (they have opted in to virtual consultations, i.e.
# Profile.willingToDoVirtualConsultations). A VERIFIED GP who has NOT opted
# in is refused. LocumStaff must EMIT this claim in the id_token for eligible
# doctors — there is no env toggle for it; it is enforced from the token.
#
# LOCAL DEV ONLY — never set in production. When true (and NODE_ENV is not
# 'production'), the directory sync falls back to a built-in mock dataset if
# LocumStaff is unconfigured/unreachable, instead of failing closed. SSO has
# NO such mock path — it always requires a real handshake.
LOCUMSTAFF_DIRECTORY_MOCK=false

