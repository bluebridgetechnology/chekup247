# ==============================================================================
# ChekUp247 Production Environment Configuration (.env.production)
# ==============================================================================

# Node Environment
NODE_ENV=production
PORT=4000

# ------------------------------------------------------------------------------
# 1. Databases (Internal Docker Network)
# ------------------------------------------------------------------------------
OPERATIONAL_DB_HOST=operational-postgres
OPERATIONAL_DB_PORT=5432
OPERATIONAL_DB_USER=chekup_prod_user
OPERATIONAL_DB_PASSWORD=CHANGE_ME_STRONG_OPERATIONAL_DB_PASSWORD
OPERATIONAL_DB_NAME=chekup_operational
OPERATIONAL_DB_SSL=false

PATIENT_DB_HOST=patient-postgres
PATIENT_DB_PORT=5432
PATIENT_DB_USER=chekup_prod_user
PATIENT_DB_PASSWORD=CHANGE_ME_STRONG_PATIENT_DB_PASSWORD
PATIENT_DB_NAME=chekup_patient
PATIENT_DB_SSL=false

# Set to true on first deployment to initialize database tables, then false once tables exist
DB_SYNCHRONIZE=true

# ------------------------------------------------------------------------------
# 2. Redis & BullMQ
# ------------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_STRONG_REDIS_PASSWORD

# ------------------------------------------------------------------------------
# 3. Object Storage (MinIO on VPS / S3 / R2)
# ------------------------------------------------------------------------------
STORAGE_ENDPOINT=http://minio:9000
STORAGE_REGION=af-south-1
STORAGE_ACCESS_KEY=CHANGE_ME_MINIO_ADMIN_ACCESS_KEY
STORAGE_SECRET_KEY=CHANGE_ME_MINIO_ADMIN_SECRET_KEY
STORAGE_BUCKET_DOCUMENTS=chekup-documents
STORAGE_BUCKET_PRESCRIPTIONS=chekup-prescriptions
STORAGE_FORCE_PATH_STYLE=true

# ------------------------------------------------------------------------------
# 4. Security & JWT (CRITICAL: Must be unique production secrets)
# ------------------------------------------------------------------------------
JWT_SECRET=GENERATE_64_CHAR_RANDOM_SECRET_KEY_FOR_JWT
JWT_EXPIRES_IN=7d
ADMIN_SESSION_SECRET=GENERATE_64_CHAR_RANDOM_SECRET_KEY_FOR_ADMIN_SESSION

# Bootstrap Administrator (Required in production on first boot)
ADMIN_BOOTSTRAP_EMAIL=admin@chekup247.com
ADMIN_BOOTSTRAP_PASSWORD=CHANGE_ME_INITIAL_ADMIN_PASSWORD_MIN_12_CHARS

# ------------------------------------------------------------------------------
# 5. Production URLs & Domain Endpoints
# ------------------------------------------------------------------------------
API_BASE_URL=https://api.chekup247.com
PATIENT_WEB_URL=https://chekup247.com
DOCTOR_PORTAL_URL=https://doctor.chekup247.com
ADMIN_PANEL_URL=https://admin.chekup247.com

# ------------------------------------------------------------------------------
# 6. Payment Gateway (Paystack Live / Test)
# ------------------------------------------------------------------------------
PAYSTACK_SECRET_KEY=sk_live_or_test_...
PAYSTACK_PUBLIC_KEY=pk_live_or_test_...
PAYSTACK_API_URL=https://api.paystack.co

# ------------------------------------------------------------------------------
# 7. Video Telehealth (Daily.co)
# ------------------------------------------------------------------------------
DAILY_API_KEY=your_daily_co_api_key_here
DAILY_DOMAIN=chekup247
DAILY_API_URL=https://api.daily.co/v1

# ------------------------------------------------------------------------------
# 8. Transactional Communications (Email, SMS & WhatsApp)
# ------------------------------------------------------------------------------
BREVO_API_KEY=your_brevo_api_key
BREVO_SENDER_EMAIL=notifications@chekup247.com
BREVO_SENDER_NAME=ChekUp Telehealth
SUPPORT_EMAIL=support@chekup247.com
SUPPORT_EMAIL_NAME=ChekUp Support

SMSPORTAL_API_KEY=
SMSPORTAL_API_SECRET=
SMSPORTAL_API_URL=https://rest.smsportal.com

# ------------------------------------------------------------------------------
# 9. LocumStaff & WHO Integrations
# ------------------------------------------------------------------------------
LOCUMSTAFF_API_URL=https://api.locumstaff.example
LOCUMSTAFF_DIRECTORY_API_KEY=
WHO_ICD_CLIENT_ID=ee7c2d56-06e6-4d70-bc20-dc9ba22d6343_b4047903-701a-40ab-aa61-ecc86861e989
WHO_ICD_CLIENT_SECRET=QOPLz7qUuTRW5DdzD8Cf1cMm2NI/0if9ZUR8/KKibTA=
